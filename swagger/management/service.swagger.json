        },
        "manufacturer": {
          "type": "string",
          "title": "Hardware manufacturer (e.g. Nintendo, Sony, Sega)"
        },
        "releaseYear": {
          "type": "integer",
          "format": "int32",
          "title": "Release year"
        },
        "iconUrl": {
          "type": "string",
          "title": "Console icon or logo URL"
        },
        "createdAt": {
          "type": "string",
          "title": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "title": "Last update timestamp"
