        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "imageAspectRatio": {
      "type": "string",
      "enum": [
        "ASPECT_RATIO_UNSPECIFIED",
        "ASPECT_RATIO_16_9_LANDSCAPE",
        "ASPECT_RATIO_16_9",
        "ASPECT_RATIO_1_1_SQUARE",
        "ASPECT_RATIO_1_1",
        "ASPECT_RATIO_32_9_ULTRA_WIDE",
        "ASPECT_RATIO_32_9",
        "ASPECT_RATIO_3_4_PORTRAIT",
        "ASPECT_RATIO_3_4",
        "ASPECT_RATIO_9_16_VERTICAL",
        "ASPECT_RATIO_9_16",
        "ASPECT_RATIO_2_3_PORTRAIT",
        "ASPECT_RATIO_2_3"
      ],
      "default": "ASPECT_RATIO_UNSPECIFIED",
      "description": "AspectRatio represents standard visual aspect ratio classifications.\n\n - ASPECT_RATIO_16_9_LANDSCAPE: 16:9 Landscape - Primary widescreen format (Recommended 1920x1080)\n - ASPECT_RATIO_1_1_SQUARE: 1:1 Square (Recommended 1080x1080)\n - ASPECT_RATIO_32_9_ULTRA_WIDE: 32:9 Ultra-Wide (OTT)\n - ASPECT_RATIO_3_4_PORTRAIT: 3:4 Portrait\n - ASPECT_RATIO_9_16_VERTICAL: 9:16 Vertical\n - ASPECT_RATIO_2_3_PORTRAIT: 2:3 Portrait"
    },
    "imageAspectRatioImages": {
      "type": "object",
      "properties": {
        "aspectRatio": {
          "$ref": "#/definitions/imageAspectRatio",
          "title": "Aspect ratio enum classification"
        },
        "imageIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Array of image UUID foreign keys"
        }
      },
      "description": "AspectRatioImages groups image IDs by aspect ratio format.\n\nReusable across all content entities\n(ROMs, games, articles, videos, etc.)"
    },
