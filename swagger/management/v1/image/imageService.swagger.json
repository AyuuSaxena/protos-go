        "name": {
          "type": "string",
          "title": "File name"
        },
        "size": {
          "type": "string",
          "format": "int64",
          "title": "File size in bytes"
        },
        "contentType": {
          "type": "string",
          "title": "MIME content type"
        },
        "etag": {
          "type": "string",
          "title": "ETag / Checksum"
        },
        "userMetadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "title": "Custom user metadata"
        },
        "createdAt": {
          "type": "string",
          "title": "Creation timestamp in RFC3339 format"
        }
      },
      "title": "File response"
    }
  },
  "securityDefinitions": {
