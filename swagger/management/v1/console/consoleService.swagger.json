  "paths": {
    "/api/v1/consoles": {
      "get": {
        "summary": "ListConsoles returns supported gaming platforms/consoles for end users.",
        "operationId": "ConsoleService_ListConsoles",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/romListConsolesResponse"
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid JWT Bearer token or x-api-key"
          },
          "403": {
            "description": "Forbidden - Insufficient permissions or invalid token claims"
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "site",
            "description": "Optional site identifier filter",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Consoles"
        ],
        "security": [
          {
            "BearerAuth": []
          },
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
