    "romConsoleInfo": {
      "type": "object",
      "properties": {
        "mongoId": {
          "type": "string",
          "title": "MongoDB internal record identifier (_id)"
        },
        "id": {
          "type": "string",
          "title": "Unique console identifier (UUID)"
        },
        "site": {
          "type": "string",
          "title": "Dynamic site/tenant key (e.g. retrogames)"
        },
        "fullName": {
          "type": "string",
          "title": "Full display name of the console"
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Supported file extensions (without leading dot)"
        },
        "manufacturer": {
          "type": "string",
          "title": "Hardware manufacturer (e.g. Nintendo, Sony, Sega)"
        },
        "releaseYear": {
          "type": "integer",
          "format": "int32",
          "title": "Release year"
        },
        "iconUrl": {
          "type": "string",
          "title": "Console icon or logo URL"
        },
        "defaultCore": {
          "type": "string",
          "title": "Default Core to use for roms belonging to this console"
        },
        "system": {
          "type": "string",
          "title": "System identifier key (e.g. nes, snes, arcade)"
        },
        "createdAt": {
          "type": "string",
          "title": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "title": "Last update timestamp"
        }
      },
      "description": "ConsoleInfo represents a gaming console system stored in the database taxonomy."
    },
    "romListConsolesResponse": {
      "type": "object",
      "properties": {
        "consoles": {
          "type": "array",
          "items": {
